# ============================================
#  Asistente de diabetes por WhatsApp
#  Copie este archivo como .env y complete los valores
# ============================================
#
# Las variables marcadas con [panel] son solo el VALOR DE FÁBRICA: se pueden
# cambiar en caliente desde /admin/configuracion, sin reiniciar el servidor.

# --- Identidad del consultorio ---
CLINICA_NOMBRE=CEM Austro
DOCTOR_NOMBRE=Dr. Carlos Padilla
# Se le da al paciente cuando hay que atenderlo en persona (informativo).
CLINICA_TELEFONO=+593 99 547 2401

# --- WhatsApp Meta Cloud API ---
# Token de acceso permanente (System User Token) de Meta for Developers.
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
# WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# Token secreto que usted inventa; debe coincidir con el que ponga en Meta.
WHATSAPP_VERIFY_TOKEN=un_token_secreto_para_verificar_webhook
# App Secret de la aplicación (Configuración > Básica). Con él se comprueba la
# firma de cada webhook. DÉJELO PUESTO EN PRODUCCIÓN: sin él, cualquiera que
# descubra la URL puede simular mensajes de un paciente.
WHATSAPP_APP_SECRET=tu_app_secret
WHATSAPP_API_VERSION=v21.0

# Plantilla aprobada por Meta para avisarle al doctor fuera de la ventana de
# 24 h. Debe tener UNA sola variable {{1}}. Sin ella, una alerta de madrugada
# solo queda en el panel.
WHATSAPP_TEMPLATE_ALERTA=alerta_paciente
WHATSAPP_TEMPLATE_LANGUAGE=es

# --- OpenAI ---
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini              # [panel]
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=700

# --- Aplicación ---
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/cemaustro.db
TIMEZONE=America/Guayaquil

# --- Autenticación de pacientes ---
# Días que dura la sesión antes de volver a pedir la cédula.
AUTH_SESSION_DAYS=90
# Minutos de validez de un código de vinculación (4320 = 3 días).
AUTH_CODE_MINUTES=4320
# Intentos fallidos antes de bloquear el número, y minutos de bloqueo.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=60
# Sal secreta con la que se resumen los códigos. Póngale una cadena larga y
# única (por ejemplo la salida de: openssl rand -hex 32).
# Si la cambia, los códigos ya emitidos dejan de servir.
AUTH_PEPPER=cambie-esta-sal-en-produccion

# --- Alertas al doctor ---
# Número del doctor en formato internacional SIN el '+'.
# Ojo: para que reciba mensajes de texto libre, él tiene que haberle escrito
# al bot en las últimas 24 h; si no, hace falta la plantilla de arriba.
DOCTOR_TELEFONO=593987654321
# Minutos mínimos entre dos avisos del mismo paciente (las urgentes se saltan
# este límite y salen siempre).
DOCTOR_ALERT_COOLDOWN_MINUTES=30

# --- Base de conocimiento ---
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5                           # [panel]
RAG_MIN_SIMILARITY=0.30

# --- Umbrales de glucemia (mg/dL) ---
# Se usan para decidir si un valor reportado merece avisarle al doctor.
GLUCOSA_HIPO_GRAVE=54
GLUCOSA_HIPO=70
GLUCOSA_ALTA_AVISO=250
GLUCOSA_ALTA_GRAVE=300
GLUCOSA_MIN=20
GLUCOSA_MAX=800

# Cuántos mensajes previos ve el modelo como contexto.
CONTEXT_MESSAGES=6                    # [panel]

# --- Panel de administración (/admin) ---
# Si deja estos campos vacíos, el panel queda DESACTIVADO.
# Muestra cédulas y datos de salud: use una contraseña larga y única.
ADMIN_USER=doctor
ADMIN_PASSWORD=cambie_esta_contrasena

# Horas de la ventana libre de WhatsApp (24 h reales, con margen).
FREE_WINDOW_HOURS=23.5

# --- Registro (logs) ---
# Archivo donde se guarda el registro de la aplicacion.
LOG_FILE=./logs/cemaustro.log
# Megabytes antes de rotar (se conserva una copia .1).
LOG_MAX_MB=5
# Escribir tambien en la consola. En segundo plano dejelo en false: en Windows,
# seleccionar texto en la terminal bloquea la escritura y congela el proceso.
LOG_CONSOLE=true

# Modelo que mira las fotos de los platos (tiene que aceptar imagenes).
OPENAI_VISION_MODEL=gpt-4o-mini
# Largo maximo de una respuesta, en caracteres (450 = unas 4 lineas de WhatsApp).
RESPONSE_MAX_CHARS=450
